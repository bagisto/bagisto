{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "install:browsers": "playwright install --with-deps chromium",
    "test:e2e": "playwright test --config=tests/e2e-pw/playwright.config.ts",
    "test:e2e:headed": "playwright test --config=tests/e2e-pw/playwright.config.ts --headed",
    "test:e2e:ui": "playwright test --config=tests/e2e-pw/playwright.config.ts --ui",
    "test:e2e:debug": "playwright test --config=tests/e2e-pw/playwright.config.ts --debug",
    "test:e2e:report": "playwright show-report tests/e2e-pw/playwright-report",
    "typecheck": "tsc --noEmit --project tests/e2e-pw/tsconfig.json",
    "format": "prettier --write tests/e2e-pw",
    "format:check": "prettier --check tests/e2e-pw"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.7.8",
    "axios": "^1.7.9",
    "laravel-vite-plugin": "^1.0",
    "prettier": "^3.8.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.2",
    "vue": "^3.5.13",
    "vue-cal": "^4.9.0"
  },
  "dependencies": {
    "@vee-validate/i18n": "^4.9.1",
    "@vee-validate/rules": "^4.9.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "dotenv": "^16.4.7",
    "flatpickr": "^4.6.13",
    "fs": "^0.0.1-security",
    "mitt": "^3.0.1",
    "playwright": "^1.48.1",
    "readline-sync": "^1.4.10",
    "vee-validate": "^4.9.1",
    "vue-flatpickr": "^2.3.0",
    "vuedraggable": "^4.1.0"
  }
}
