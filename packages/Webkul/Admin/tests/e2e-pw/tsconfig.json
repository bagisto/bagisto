{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM"],
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "baseUrl": ".",
        "paths": {
            "@pages/*": ["pages/*"],
            "@utils/*": ["utils/*"],
            "@data/*": ["data/*"],
            "@shared/*": ["../../../../../tests/e2e-pw/helpers/*"]
        },
        "types": ["node"]
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules", "playwright-report", "test-results", ".state"]
}
